<?xml version="1.0"?>
<launch>

    <!-- EDIT:
    create a folder in HOME: 'bagfiles' bag will be recorded here
    add to .bashrc: 'export ROS_BAGS="$HOME/bagfiles"' -->

    <!--arguments-->
    <arg name="bag" default="$(env ROS_BAGS)/data.bag"/>

    <arg name="simulation" default="true"/>
    <param name="/use_sim_time" value="$(arg simulation)"/>

    <!-- List topics to record -->
    <node name="rosbag_record" pkg="rosbag" type="record" output="screen" args="
        /tf
        /tf_static
        /joint_states

        /imu
        /hand_rgb/image_raw
        /hand_rgb/camera_info 

        /elbow_joint_sensor/value
        /shoulder_lift_joint_sensor/value
        /shoulder_pan_joint_sensor/value
        /wrist_1_joint_sensor/value
        /wrist_2_joint_sensor/value
        /wrist_3_joint_sensor/value

        -o $(arg bag)">
    </node>

</launch>