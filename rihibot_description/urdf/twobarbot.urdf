<?xml version="1.0"?>
<robot name="/home/diogo/ros_workspaces/rihibot_ws/src/robots/rihibot/rihibot_description/urdf/twobarbot.urdf" xmlns:xacro="http://ros.org/wiki/xacro">
  <link name="base_link">
  </link>
  <link name="bar_base_link">
  </link>
  <joint name="base_link_bar_base_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="bar_base_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>
  <joint name="joint1" type="continuous">
    <parent link="bar_base_link"/>
    <child link="bar_link"/>
    <axis xyz="1 0 0"/>
    <limit effort="10" velocity="10"/>
    <origin xyz="0 0 0.05" rpy="1.57 0 0"/>
  </joint>
  <link name="bar_link">
  </link>
  <joint name="joint2" type="continuous">
    <parent link="bar_link"/>
    <child link="endeffector"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10"/>
    <origin xyz="0 0.62 0.000048" rpy="0 0 0"/>
  </joint>
  <link name="endeffector">
  </link>
  <link name="accelerometer">
  </link>
  <joint name="endeffector_accelerometer_joint" type="fixed">
    <parent link="endeffector"/>
    <child link="accelerometer"/>
    <origin xyz="0 0.23 0" rpy="0 0 0"/>
  </joint>
</robot>
